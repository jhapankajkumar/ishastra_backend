// PRIORITY 1: TradeOutcome Table (REQUIRED for AI Learning)
model TradeOutcome {
  id                Int       @id @default(autoincrement())
  
  // Basic Trade Info
  symbol            String    // Stock symbol
  userId            String?   // User identifier
  tradeId           String?   // Link to existing Trade table
  
  // Trade Timeline
  entryDate         DateTime
  exitDate          DateTime?
  entryPrice        Float
  exitPrice         Float?
  quantity          Int
  
  // Trade Performance
  outcome           String    // "WIN", "LOSS", "BREAKEVEN"
  pnlPercent        Float     // Profit/Loss percentage
  daysHeld          Int?      // Days trade was held
  
  // AI Enhancement Tracking
  aiEnhanced        Boolean   @default(false)
  originalGrade     String?   // System grade (e.g., "B+")
  enhancedGrade     String?   // AI enhanced grade
  originalConfidence Float?   // System confidence
  enhancedConfidence Float?   // AI confidence
  systemUsed        String?   // Trading system used
  
  // Metadata
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Indexes for performance
  @@index([symbol, userId])
  @@index([entryDate])
  @@index([aiEnhanced])
}

