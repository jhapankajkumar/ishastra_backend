{
  "name": "ishastra_backend",
  "version": "1.0.0",
  "description": "A trade journal application backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "nodemon src/server.js",
    "dev": "nodemon --exec ts-node src/server.js",
    "dev:ts": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "cp -r prisma dist/",
    "seed": "ts-node src/seed.js",
    "investment-seed": "ts-node src/investment_seed.js",
    "test": "jest",
    "test:acceptance": "jest tests/acceptance",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhapankajkumar/ishastra_backend.git"
  },
  "keywords": [
    "trading",
    "journal",
    "finance",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jhapankajkumar/ishastra_backend/issues"
  },
  "homepage": "https://github.com/jhapankajkumar/ishastra_backend#readme",
  "dependencies": {
    "@prisma/client": "^4.16.2",
    "@tensorflow/tfjs-node": "^4.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-jwt": "^8.5.1",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "jstat": "^1.9.6",
    "lodash": "^4.17.21",
    "luxon": "^3.7.1",
    "mailgun.js": "^12.0.3",
    "mathjs": "^14.6.0",
    "moment-timezone": "^0.6.0",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "openai": "^5.16.0",
    "prisma": "^4.16.2",
    "sqlite3": "^5.1.7",
    "technicalindicators": "^3.1.0",
    "undici": "^7.13.0",
    "xml2js": "^0.6.2",
    "yahoo-finance2": "^2.13.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "axios": "^1.11.0",
    "jest": "^30.0.5",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
