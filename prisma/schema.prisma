generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TradeFill {
  id            Int       @id @default(autoincrement())
  tradeId       Int?
  type          String    // Suggested: Convert to enum (e.g. "Entry", "Exit", "Adjustment")
  fillDate      DateTime
  orderPrice    Float?
  filledPrice   Float?
  slippage      Float?
  quantity      Int?
  totalCost     Float?
  dayHigh       Float?
  dayLow        Float?
  gradePercent  Float?

  trade         Trade?    @relation(fields: [tradeId], references: [id])
}

model TradeImage {
  id         Int      @id @default(autoincrement())
  tradeId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  trade      Trade?   @relation(fields: [tradeId], references: [id])
}

model Trade {
  id                 Int       @id @default(autoincrement())
  
  //entry
  tradeId            String    @unique        // e.g., ISH-2025-000001
  ticker             String
  direction          String    // Consider enum: LONG, SHORT
  instrumentType     String?   // Stocks, Options, Futures
  entryPrice         Float?
  stopLoss           Float?
  target1            Float?
  target2            Float?
  target3            Float?
  quantity           Int?
  
  entryCommission    Float?
  entryDate          DateTime?
  reasonForEntry     String?
  confidenceRating   Int?
  tradeSetupId       Int?
  timeframeUsed      String?
  notes              String?
  atrValue           Float?
  riskPerTrade       String?
  riskPerTradeValue  Float?
  createdAt          DateTime  @default(now())

//Exit
  exitDate           DateTime?
  exitPrice          Float?
  exitCommission     Float?
  remainingQuantity  Int?
  reasonForExit      String?
  exitTacticId       Int?

  rMultiple          Float?
  postTradeAnalysis  String?
  isPaperTrade       Boolean?
  status             String?   @default("Open") // Open, Partial Closed, Closed
  tags               String?   // Consider making tags a separate join table
  tradeFills         TradeFill[]
  tradeImages        TradeImage[]
  tradeTransactions  TradeTransaction[]
}

model TradeTransaction {
  id               Int      @id @default(autoincrement())
  tradeId          Int
  transactionType  String   // ENUM: "Entry", "Exit"
  quantity         Int
  price            Float
  transactionDate  DateTime
  reasonForExit    String?
  exitTacticId     Int?
  createdAt        DateTime @default(now())

  trade            Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model ChartAnalysis {
  id                  Int      @id @default(autoincrement())
  entryDate           DateTime
  ticker              String
  trend               String?
  candleType          String?
  nearSupport         Boolean?
  nearResistance      Boolean?
  supportLevel        Float?
  resistanceLevel     Float?
  emaTouch            Boolean?
  volumeSpike         Boolean?
  rsiValue            Float?
  entryConsidered     Boolean?
  actionPlan          String?
  entryNotes          String?
  reviewNotes         String?
  createdAt           DateTime @default(now())
  chartImages         ChartImage[]
}

model ChartImage {
  id         Int      @id @default(autoincrement())
  chartId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  chartAnalysis      ChartAnalysis?   @relation(fields: [chartId], references: [id])
}

model Recommendation {
  id            Int       @id @default(autoincrement())
  ticker        String
  buyBelow      Float?
  currentPrice  Float?
  sector        String?   // Optional, useful for filtering
  source        String?   // e.g., blog, analyst, group name
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Investment {
  id               Int       @id @default(autoincrement())
  ticker           String    // Stock symbol
  quantity         Int       // Total quantity bought
  avgBuyPrice      Float?    // Average buy price per share
  totalInvestment  Float?    // Optional calculated field (qty * avgBuyPrice)
  buyBelow         Float?    // Suggested entry level
  currentPrice     Float?    // Latest fetched price
  status           String    @default("open") // "open", "closed"
  entryDate        DateTime  // When investment was made
  exitDate         DateTime? // When investment was closed (if any)
  remainingQty     Int?      // Quantity still held (after partial sells)
  isRecommended    Boolean?  // If the investment is recommendation
  notes            String?   // Optional remark or rationale
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  marketCap        String?
  sector           String?
  // Relations
  transactions     InvestmentTransaction[] // Partial exits or averaging
}

model InvestmentTransaction {
  id                Int         @id @default(autoincrement())
  investmentId      Int
  type              String      // "Buy" or "Sell"
  quantity          Int
  price             Float
  transactionDate   DateTime
  exitReason        String?     // Only for sell transactions
  createdAt         DateTime    @default(now())
  investment        Investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}
