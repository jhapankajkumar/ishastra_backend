generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TradeFill {
  id            Int       @id @default(autoincrement())
  tradeId       Int?
  type          String    // Suggested: Convert to enum (e.g. "Entry", "Exit", "Adjustment")
  fillDate      DateTime
  orderPrice    Float?
  filledPrice   Float?
  slippage      Float?
  quantity      Int?
  totalCost     Float?
  dayHigh       Float?
  dayLow        Float?
  gradePercent  Float?

  trade         Trade?    @relation(fields: [tradeId], references: [id])
}

model TradeImage {
  id         Int      @id @default(autoincrement())
  tradeId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  trade      Trade?   @relation(fields: [tradeId], references: [id])
}

model Trade {
  id                 Int       @id @default(autoincrement())
  
  //entry
  tradeId            String    @unique        // e.g., ISH-2025-000001
  ticker             String
  tickerName         String?
  direction          String    // Consider enum: LONG, SHORT
  instrumentType     String?   // Stocks, Options, Futures
  currency           String?   @default("USD") // 'USD' or 'INR'
  entryPrice         Float?
  stopLoss           Float?
  target1            Float?
  target2            Float?
  target3            Float?
  quantity           Int?
  currentPrice       Float?    // Latest fetched price
  
  entryCommission    Float?
  entryDate          DateTime?
  reasonForEntry     String?
  confidenceRating   Int?
  tradeSetupId       Int?
  timeframeUsed      String?
  notes              String?
  atrValue           Float?
  riskPerTrade       String?
  riskPerTradeValue  Float?
  createdAt          DateTime  @default(now())

//Exit
  exitDate           DateTime?
  exitPrice          Float?
  exitCommission     Float?
  remainingQuantity  Int?
  reasonForExit      String?
  exitTacticId       Int?

//Review
  postTradeAnalysis  String?
  lessonLearned      String?
  emotionalState       String?

  status             String?   @default("Open") // Open, Partial Closed, Closed
  tags               String?   // Consider making tags a separate join table
  
  // Analysis and Learning Fields
  rMultiple          Float?    // Risk-reward ratio outcome
  isPaperTrade       Boolean?  // Whether this was practice
  
  tradeFills         TradeFill[]
  tradeImages        TradeImage[]
  tradeTransactions  TradeTransaction[]
}

model TradeTransaction {
  id               Int      @id @default(autoincrement())
  tradeId          Int
  transactionType  String   // ENUM: "Entry", "Exit"
  quantity         Int
  price            Float
  transactionDate  DateTime
  reasonForExit    String?
  exitTacticId     Int?
  createdAt        DateTime @default(now())
  
  // Exit Transaction Outcome Fields (null for entry transactions)
  outcome           String?    // "WIN", "LOSS", "BREAKEVEN" - only for exits
  pnlAmount         Float?     // Profit/Loss in dollars - only for exits
  pnlPercent        Float?     // Profit/Loss percentage - only for exits
  entryPrice        Float?     // For exit transactions - original entry price
  daysHeld          Int?       // For exit transactions - days position was held
  
  trade            Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model ChartAnalysis {
  id                  Int      @id @default(autoincrement())
  entryDate           DateTime
  ticker              String
  tickerName          String?
  trend               String?
  candleType          String?
  nearSupport         Boolean?
  nearResistance      Boolean?
  supportLevel        Float?
  resistanceLevel     Float?
  emaTouch            Boolean?
  volumeSpike         Boolean?
  rsiValue            Float?
  entryConsidered     Boolean?
  actionPlan          String?
  entryNotes          String?
  reviewNotes         String?
  setupConfidence     String
  setupType           Int?
  createdAt           DateTime @default(now())
  chartImages         ChartImage[]
}

model ChartImage {
  id         Int      @id @default(autoincrement())
  chartId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  chartAnalysis      ChartAnalysis?   @relation(fields: [chartId], references: [id])
}

model Recommendation {
  id            Int       @id @default(autoincrement())
  ticker        String
  buyBelow      Float?
  currentPrice  Float?
  sector        String?   // Optional, useful for filtering
  source        String?   // e.g., blog, analyst, group name
  marketCap        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Investment {
  id               Int       @id @default(autoincrement())
  ticker           String    // Stock symbol
  currency         String?   @default("USD") // 'USD' or 'INR'
  quantity         Int       // Total quantity bought
  avgBuyPrice      Float?    // Average buy price per share
  totalInvestment  Float?    // Optional calculated field (qty * avgBuyPrice)
  buyBelow         Float?    // Suggested entry level
  currentPrice     Float?    // Latest fetched price
  status           String    @default("open") // "open", "closed"
  entryDate        DateTime  // When investment was made
  exitDate         DateTime? // When investment was closed (if any)
  remainingQty     Int?      // Quantity still held (after partial sells)
  isRecommended    Boolean?  // If the investment is recommendation
  notes            String?   // Optional remark or rationale
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  marketCap        String?
  sector           String?
  lastDayPrice     Float?
  // Relations
  transactions     InvestmentTransaction[] // Partial exits or averaging
}

model InvestmentTransaction {
  id                Int         @id @default(autoincrement())
  investmentId      Int
  type              String      // "Buy" or "Sell"
  quantity          Int
  price             Float
  transactionDate   DateTime
  exitReason        String?     // Only for sell transactions
  createdAt         DateTime    @default(now())
  investment        Investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model Capital {
  id              String   @id @default(uuid())
  currency        String   @unique // 'USD' or 'INR'
  total           Float    // Total capital allocated
  remaining       Float    // Remaining capital after open trades
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Watchlist Schema - SIMPLE & CLEAN - Stores complete signal analysis data
model WatchlistStock {
  id              Int      @id @default(autoincrement())
  symbol          String   @unique // Stock symbol (e.g., "AAPL", "RELIANCE.NS")
  currentPrice    Float    // Price when analyzed
  currency        String?  @default("USD") // 'USD' or 'INR'
  market          String?  // 'US' or 'IN' 
  
  // Decision Information - Core signal data
  decisionAction      String   // "BUY", "WATCH", "HOLD", "AVOID", "SELL"
  decisionConfidence  Float    // 0.0 to 1.0
  decisionGrade      String   // "A", "B+", "C", etc.
  decisionReasoning  String?  // Brief reasoning text
  systemsAgreement   String?  // "FULL", "PARTIAL", "NONE"
  systemsAnalyzed    Int?     // Number of systems analyzed
  
  // Execution Data (JSON from signal-analysis.controller.js)
  executionData   String?  // JSON: Complete execution object { entry, stopLoss, targets, position }
  
  // Systems Data (JSON from signal-analysis.controller.js) 
  systemsData     String?  // JSON: Complete systems analysis results
  
  // Context Data (JSON from signal-analysis.controller.js)
  contextData     String?  // JSON: Complete context { trend, levels, volume, earnings }
  
  // Risk Data (JSON from signal-analysis.controller.js)
  riskData        String?  // JSON: Complete risk analysis { level, tailRiskScore, maxDrawdown }
  
  // Status and Metadata
  status          String   @default("ACTIVE") // "ACTIVE", "EXECUTED", "EXPIRED", "REMOVED"
  priority        Int      @default(1)        // 1=Low, 2=Medium, 3=High (based on grade/confidence)
  nextStepSummary String?  // What to do next
  
  // Timestamps
  addedAt         DateTime @default(now())
  lastAnalyzedAt  DateTime @default(now()) 
  updatedAt       DateTime @updatedAt
  
  @@index([decisionAction])
  @@index([decisionGrade])
  @@index([priority])
  @@index([market])
  @@index([status])
}

// ===== LEARNING & OBSERVATION MODELS =====
// These models are for learning and improving trading skills:
// - Trade: Records all trade decisions and outcomes for review
// - ChartAnalysis: Journal for studying chart patterns and setups  
// - TradeFill: Multiple fills per trade (real trading data)
// - TradeImage: Screenshots for trade review and learning
