generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model exit_tactics {
  /// ⚠️ This model contains static, read-only values inserted during initial seed
  id          Int     @id @default(autoincrement())
  tactic_id   Int     @unique
  name        String  @unique
  description String?
}

model tags {
  /// ⚠️ This model contains static, read-only values inserted during initial seed
  id     Int    @id @default(autoincrement())
  tag_id Int    @unique
  name   String @unique
  description String?
}

model trade_fills {
  id            Int      @id @default(autoincrement())
  trade_id      Int?     // Keep as Int for now during migration
  type          String
  fill_date     DateTime
  order_price   Float?
  filled_price  Float?
  slippage      Float?
  shares        Int?
  total_cost    Float?
  day_high      Float?
  day_low       Float?
  grade_percent Float?
  trades        trades?  @relation(fields: [trade_id], references: [id])
}

model trade_images {
  id          Int       @id @default(autoincrement())
  trade_id    Int?      // Keep as Int for now during migration
  image_type  String
  file_path   String
  uploaded_at DateTime? @default(now())
  trades      trades?   @relation(fields: [trade_id], references: [id])
}

model trades {
  id                  Int                 @id @default(autoincrement())
  trade_id            String              @unique // Professional trade ID (ISH-2025-000001)
  user_id             Int?
  ticker              String
  direction           String
  instrument_type     String?             // Stocks, Options, Futures, etc.
  setup               String?
  entry_price         Float?
  exit_price          Float?
  stop_loss           Float?
  target_1            Float?              // First profit target
  target_2            Float?              // Second profit target  
  target_3            Float?              // Third profit target
  quantity            Int?
  remaining_quantity  Int?                // New field for partial exits
  entry_commission    Float?              // Commission paid on entry
  exit_commission     Float?              // Commission paid on exit
  r_multiple          Float?
  result              String?
  entry_date          DateTime?
  exit_date           DateTime?
  reason_for_entry    String?
  reason_for_exit     String?
  post_trade_analysis String?
  confidence_rating   Int?                // 1-10 setup confidence
  exit_tactic_id      Int?
  trade_setup_id      Int?
  timeframe_used      String?             // 1m, 5m, 15m, 1h, 4h, 1d, etc.
  notes               String?             // General trading notes
  atr_value           Float?              // ATR at time of entry
  risk_per_trade      Float?              // Risk amount or percentage
  created_at          DateTime?           @default(now())
  is_paper_trade      Boolean?
  status              String?             @default("Open") // Open, Partial Closed, Closed
  trade_fills         trade_fills[]
  trade_images        trade_images[]
  // Temporarily remove the problematic relation
  // trade_transactions  trade_transactions[] // New relation for partial exits
  tags                String?
}

model trade_transactions {
  id              Int      @id @default(autoincrement())
  trade_id        Int      // Keep as Int for now during migration
  transaction_type String  // "Exit", "Entry" (for future position adds)
  quantity        Int
  price           Float
  transaction_date DateTime
  reason_for_exit String?
  exit_tactic_id  Int?
  created_at      DateTime @default(now())
  // Temporarily remove the foreign key constraint
  // trade           trades   @relation(fields: [trade_id], references: [id], onDelete: Cascade)
}

model users {
  id            Int       @id @default(autoincrement())
  username      String    @unique(map: "sqlite_autoindex_users_1")
  password_hash String
  created_at    DateTime? @default(now())
}

model trade_setups {
  id             Int     @id @default(autoincrement())
  trade_setup_id Int     @unique
  name           String  @unique
  description    String?
}

model chart_readings {
  id               Int      @id @default(autoincrement())
  date             DateTime
  stock            String
  trend            String?
  candle_type      String?
  near_support     Boolean?
  near_resistance  Boolean?
  support_level    Float?
  resistance_level Float?
  ema_touch        Boolean?
  volume_spike     Boolean?
  rsi_value        Float?
  entry_considered Boolean?
  action_plan      String?
  notes            String?
  screenshot_url   String?
  review_screenshot_url String?
  created_at       DateTime @default(now())
}
