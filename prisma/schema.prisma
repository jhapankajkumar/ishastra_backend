generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int       @id @default(autoincrement())
  email                       String    @unique
  passwordHash                String
  role                        String    @default("USER") // "USER" | "SUPERUSER" — see src/utils/roles.js
  preferredCurrency           String?   // "USD" | "INR" — chosen once at registration; null for SUPERUSER (exempt)
  avatarUrl                   String?
  emailVerified               Boolean   @default(false)
  otpCodeHash                 String?
  otpExpiresAt                DateTime?
  passwordResetTokenHash      String?   @unique
  passwordResetTokenExpiresAt DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  refreshTokens               RefreshToken[]
  trades                      Trade[]
  investments                 Investment[]
  recommendations             Recommendation[]
  chartAnalyses               ChartAnalysis[]
  watchlistStocks             WatchlistStock[]
  capitals                    Capital[]
  backtestTrades              BacktestTrade[]
  capitalTransactions         CapitalTransaction[]
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              Int
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
}

model TradeFill {
  id            Int       @id @default(autoincrement())
  tradeId       Int?
  type          String    // Suggested: Convert to enum (e.g. "Entry", "Exit", "Adjustment")
  fillDate      DateTime
  orderPrice    Float?
  filledPrice   Float?
  slippage      Float?
  quantity      Int?
  totalCost     Float?
  dayHigh       Float?
  dayLow        Float?
  gradePercent  Float?

  trade         Trade?    @relation(fields: [tradeId], references: [id])
}

model TradeImage {
  id         Int      @id @default(autoincrement())
  tradeId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  trade      Trade?   @relation(fields: [tradeId], references: [id])
}

model Trade {
  id                 Int       @id @default(autoincrement())
  
  //entry
  tradeId            String                    // e.g., ISH-2025-000001 — unique per user, see @@unique below
  ticker             String
  tickerName         String?
  direction          String    // Consider enum: LONG, SHORT
  instrumentType     String?   // Stocks, Options, Futures
  currency           String?   @default("USD") // 'USD' or 'INR'
  currentPrice       Float?    // Latest fetched price
  lastDayPrice       Float? 
  
  //Trade System 
  tradeSetupId       Int? //Minervini/Momentum/Elder
  confidence         Int?
  grade              String?
  
  //Entry
  entryDate          DateTime?
  reasonForEntry     String?
  entryCommission    Float?

  //Execution
  quantity           Int?
  entryPrice         Float?
  stopLoss           Float?
  target1            Float?
  target2            Float?
  target3            Float?
  notes              String?


  createdAt          DateTime  @default(now())

//Exit
  exitDate           DateTime?
  exitPrice          Float?
  exitCommission     Float?
  remainingQuantity  Int?
  reasonForExit      String?
  exitTacticId       Int?

//Review
  postTradeAnalysis  String?
  lessonLearned      String?
  emotionalState     String?

  status             String?   @default("Open") // Open, Partial Closed, Closed
  tags               String?   // Consider making tags a separate join table
  
  // Analysis and Learning Fields
  rMultiple          Float?    // Risk-reward ratio outcome
  isPaperTrade       Boolean?  // Whether this was practice

  // Full Stock Analysis as json
  systemAnalysisResult      String?

  // Ownership — NULL means "guest sandbox row" (permanent signal, not migration debt)
  userId             Int?
  user               User?     @relation(fields: [userId], references: [id])

  tradeFills         TradeFill[]
  tradeImages        TradeImage[]
  tradeTransactions  TradeTransaction[]

  @@unique([userId, tradeId])
}

model TradeTransaction {
  id               Int      @id @default(autoincrement())
  tradeId          Int
  transactionType  String   // ENUM: "Entry", "Exit"
  quantity         Int
  price            Float
  commission       Float?
  transactionDate  DateTime
  reasonForExit    String?
  exitTacticId     Int?
  createdAt        DateTime @default(now())
  
  trade            Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model ChartAnalysis {
  id                  Int      @id @default(autoincrement())
  entryDate           DateTime
  ticker              String
  tickerName          String?
  trend               String?
  candleType          String?
  nearSupport         Boolean?
  nearResistance      Boolean?
  supportLevel        Float?
  resistanceLevel     Float?
  emaTouch            Boolean?
  volumeSpike         Boolean?
  rsiValue            Float?
  entryConsidered     Boolean?
  actionPlan          String?
  entryNotes          String?
  reviewNotes         String?
  setupConfidence     String
  setupType           Int?
  createdAt           DateTime @default(now())
  chartImages         ChartImage[]

  // Ownership — NULL means "guest sandbox row" (permanent signal, not migration debt)
  userId              Int?
  user                User?    @relation(fields: [userId], references: [id])
  isPaperTrade        Boolean? @default(false)
}

model ChartImage {
  id         Int      @id @default(autoincrement())
  chartId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  chartAnalysis      ChartAnalysis?   @relation(fields: [chartId], references: [id])
}

model Recommendation {
  id            Int       @id @default(autoincrement())
  ticker        String
  buyBelow      Float?
  currentPrice  Float?
  sector        String?   // Optional, useful for filtering
  source        String?   // e.g., blog, analyst, group name
  marketCap        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Ownership — NULL means "guest sandbox row" (permanent signal, not migration debt)
  userId        Int?
  user          User?     @relation(fields: [userId], references: [id])
  isPaperTrade  Boolean?  @default(false)
}

model Investment {
  id               Int       @id @default(autoincrement())
  ticker           String    // Stock symbol
  currency         String?   @default("USD") // 'USD' or 'INR'
  quantity         Int       // Total quantity bought
  avgBuyPrice      Float?    // Average buy price per share
  totalInvestment  Float?    // Optional calculated field (qty * avgBuyPrice)
  buyBelow         Float?    // Suggested entry level
  currentPrice     Float?    // Latest fetched price
  status           String    @default("open") // "open", "closed"
  entryDate        DateTime  // When investment was made
  exitDate         DateTime? // When investment was closed (if any)
  remainingQty     Int?      // Quantity still held (after partial sells)
  isRecommended    Boolean?  // If the investment is recommendation
  notes            String?   // Optional remark or rationale
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  marketCap        String?
  sector           String?
  lastDayPrice     Float?
  // Relations
  transactions     InvestmentTransaction[] // Partial exits or averaging

  // Ownership — NULL means "guest sandbox row" (permanent signal, not migration debt)
  userId           Int?
  user             User?     @relation(fields: [userId], references: [id])
  isPaperTrade     Boolean?  @default(false)
}

model InvestmentTransaction {
  id                Int         @id @default(autoincrement())
  investmentId      Int
  type              String      // "Buy" or "Sell"
  quantity          Int
  price             Float
  transactionDate   DateTime
  exitReason        String?     // Only for sell transactions
  createdAt         DateTime    @default(now())
  investment        Investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model Capital {
  id              String   @id @default(uuid())
  currency        String   // 'USD' or 'INR' — unique per user, see @@unique below
  total           Float    // Total capital allocated
  remaining       Float    // Remaining capital after open trades
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Ownership — required (Migration 4). No guest concept for Capital at all.
  userId              Int
  user                User                 @relation(fields: [userId], references: [id])
  capitalTransactions CapitalTransaction[]

  @@unique([userId, currency])
}

// Deposit/withdraw ledger — every balance change is a permanent row here,
// not just a mutation of Capital.total/remaining. See plan's "why a ledger"
// note: a single mutable number can't answer "when/why did my balance change."
model CapitalTransaction {
  id           String   @id @default(uuid())
  capitalId    String
  capital      Capital  @relation(fields: [capitalId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  type         String   // "DEPOSIT" | "WITHDRAW"
  amount       Float
  currency     String
  balanceAfter Float    // Capital.remaining snapshot right after this transaction — the audit trail
  note         String?
  createdAt    DateTime @default(now())
}

// Watchlist Schema - SIMPLE & CLEAN - Stores complete signal analysis data
model WatchlistStock {
  id              Int      @id @default(autoincrement())
  symbol          String   // Stock symbol (e.g., "AAPL", "RELIANCE.NS") — unique per user, see @@unique below
  currentPrice    Float    // Price when analyzed
  currency        String?  @default("USD") // 'USD' or 'INR'
  market          String?  // 'US' or 'IN'
  entryPrice      Float   @default(0) // Price when analyzed
  // Execution Data (JSON from signal-analysis.controller.js)
  decision        String?

  // Execution Data (JSON from signal-analysis.controller.js)
  execution       String?  // JSON: Complete execution object { entry, stopLoss, targets, position }

  // Timestamps
  createdAt         DateTime @default(now())

  // Ownership — required (Migration 4). No guest concept for Watchlist at all.
  userId             Int
  user               User     @relation(fields: [userId], references: [id])

  @@unique([userId, symbol])
}


model BacktestTrade {
   id          Int      @id @default(autoincrement())
   symbol      String
   entryDate   DateTime
   exitDate    DateTime
   entryPrice  Float
   exitPrice   Float
   stopLoss    Float
   target      Float
   reason      String  // 'STOP' | 'TARGET' | 'TIME'
   RMultiple   Float
   system      String?

   // Ownership — required (Migration 4).
   userId      Int
   user        User    @relation(fields: [userId], references: [id])
 }