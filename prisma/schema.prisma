generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TradeFill {
  id            Int       @id @default(autoincrement())
  tradeId       Int?
  type          String    // Suggested: Convert to enum (e.g. "Entry", "Exit", "Adjustment")
  fillDate      DateTime
  orderPrice    Float?
  filledPrice   Float?
  slippage      Float?
  quantity      Int?
  totalCost     Float?
  dayHigh       Float?
  dayLow        Float?
  gradePercent  Float?

  trade         Trade?    @relation(fields: [tradeId], references: [id])
}

model TradeImage {
  id         Int      @id @default(autoincrement())
  tradeId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  trade      Trade?   @relation(fields: [tradeId], references: [id])
}

model Trade {
  id                 Int       @id @default(autoincrement())
  
  //entry
  tradeId            String    @unique        // e.g., ISH-2025-000001
  ticker             String
  tickerName         String?
  direction          String    // Consider enum: LONG, SHORT
  instrumentType     String?   // Stocks, Options, Futures
  currency           String?   @default("USD") // 'USD' or 'INR'
  entryPrice         Float?
  stopLoss           Float?
  target1            Float?
  target2            Float?
  target3            Float?
  quantity           Int?
  currentPrice       Float?    // Latest fetched price
  
  entryCommission    Float?
  entryDate          DateTime?
  reasonForEntry     String?
  confidenceRating   Int?
  tradeSetupId       Int?
  timeframeUsed      String?
  notes              String?
  atrValue           Float?
  riskPerTrade       String?
  riskPerTradeValue  Float?
  createdAt          DateTime  @default(now())

//Exit
  exitDate           DateTime?
  exitPrice          Float?
  exitCommission     Float?
  remainingQuantity  Int?
  reasonForExit      String?
  exitTacticId       Int?

//Review
  postTradeAnalysis  String?
  lessonLearned      String?
  emotionalState       String?

  grade           String?   // AI enhanced grade
  confidence      Float?    // AI confidence score
  narrative       String?   // AI market narrative
  riskFactors     String?   // JSON array of AI risk factors

  rMultiple          Float?
  isPaperTrade       Boolean?
  status             String?   @default("Open") // Open, Partial Closed, Closed
  tags               String?   // Consider making tags a separate join table
  tradeFills         TradeFill[]
  tradeImages        TradeImage[]
  tradeTransactions  TradeTransaction[]
  tradeAlerts        TradeAlert[]
}

model TradeTransaction {
  id               Int      @id @default(autoincrement())
  tradeId          Int
  transactionType  String   // ENUM: "Entry", "Exit"
  quantity         Int
  price            Float
  transactionDate  DateTime
  reasonForExit    String?
  exitTacticId     Int?
  createdAt        DateTime @default(now())

  grade           String?   // AI enhanced grade
  confidence      Float?    // AI confidence score
  narrative       String?   // AI market narrative
  riskFactors     String?   // JSON array of AI risk factors
  
  // Exit Transaction Outcome Fields (null for entry transactions)
  outcome           String?    // "WIN", "LOSS", "BREAKEVEN" - only for exits
  pnlAmount         Float?     // Profit/Loss in dollars - only for exits
  pnlPercent        Float?     // Profit/Loss percentage - only for exits
  entryPrice        Float?     // For exit transactions - original entry price
  daysHeld          Int?       // For exit transactions - days position was held
  
  trade            Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model ChartAnalysis {
  id                  Int      @id @default(autoincrement())
  entryDate           DateTime
  ticker              String
  tickerName          String?
  trend               String?
  candleType          String?
  nearSupport         Boolean?
  nearResistance      Boolean?
  supportLevel        Float?
  resistanceLevel     Float?
  emaTouch            Boolean?
  volumeSpike         Boolean?
  rsiValue            Float?
  entryConsidered     Boolean?
  actionPlan          String?
  entryNotes          String?
  reviewNotes         String?
  setupConfidence     String
  setupType           Int?
  createdAt           DateTime @default(now())
  chartImages         ChartImage[]
}

model ChartImage {
  id         Int      @id @default(autoincrement())
  chartId    Int?
  imageType  String
  filePath   String
  uploadedAt DateTime @default(now())
  chartAnalysis      ChartAnalysis?   @relation(fields: [chartId], references: [id])
}

model Recommendation {
  id            Int       @id @default(autoincrement())
  ticker        String
  buyBelow      Float?
  currentPrice  Float?
  sector        String?   // Optional, useful for filtering
  source        String?   // e.g., blog, analyst, group name
  marketCap        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Investment {
  id               Int       @id @default(autoincrement())
  ticker           String    // Stock symbol
  currency         String?   @default("USD") // 'USD' or 'INR'
  quantity         Int       // Total quantity bought
  avgBuyPrice      Float?    // Average buy price per share
  totalInvestment  Float?    // Optional calculated field (qty * avgBuyPrice)
  buyBelow         Float?    // Suggested entry level
  currentPrice     Float?    // Latest fetched price
  status           String    @default("open") // "open", "closed"
  entryDate        DateTime  // When investment was made
  exitDate         DateTime? // When investment was closed (if any)
  remainingQty     Int?      // Quantity still held (after partial sells)
  isRecommended    Boolean?  // If the investment is recommendation
  notes            String?   // Optional remark or rationale
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  marketCap        String?
  sector           String?
  lastDayPrice     Float?
  // Relations
  transactions     InvestmentTransaction[] // Partial exits or averaging
}

model InvestmentTransaction {
  id                Int         @id @default(autoincrement())
  investmentId      Int
  type              String      // "Buy" or "Sell"
  quantity          Int
  price             Float
  transactionDate   DateTime
  exitReason        String?     // Only for sell transactions
  createdAt         DateTime    @default(now())
  investment        Investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model Capital {
  id              String   @id @default(uuid())
  currency        String   @unique // 'USD' or 'INR'
  total           Float    // Total capital allocated
  remaining       Float    // Remaining capital after open trades
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Watchlist Schema - Automated from Signal Analysis
model WatchlistStock {
  id              Int      @id @default(autoincrement())
  symbol          String   @unique // Stock symbol (e.g., "AAPL", "ASHIANA.NS")
  currentPrice    Float    // Price when added to watchlist
  currency        String?  @default("USD") // 'USD' or 'INR'
  market          String?  // 'US' or 'IN' 
  
  // Decision Information
  decisionAction      String   // "BUY", "WATCH", "HOLD", etc.
  decisionConfidence  Float    // 0.0 to 1.0
  decisionGrade      String   // "A", "B+", "C", etc.
  decisionReasoning  String?  // Brief reasoning text
  systemsAgreement   String?  // "FULL", "PARTIAL", "NONE"
  systemsAnalyzed    Int?     // Number of systems analyzed
  
  // ===== ELITE SYSTEM FIELDS (Top 1% Trader Features) =====
  tier               String?  // "HOT_BUY", "STRONG_WATCH", "DEVELOPING", "COOLING", "ARCHIVE"
  signalEvolution    String?  // "IMPROVING", "DETERIORATING", "STABLE_STRONG", "NEW_BREAKOUT", "STABLE_WEAK"
  daysInTier         Int?     @default(0) // Days in current tier
  historicalGrades   String?  // JSON: Array of historical grades for trend analysis
  tierHistory        String?  // JSON: Array of tier changes with timestamps
  strengthTrend      String?  // "STRENGTHENING", "WEAKENING", "STABLE", "UNKNOWN"
  momentumMultiplier Float?   @default(1.0) // Elite momentum calculation
  elitePriority      Int?     @default(1000) // Elite ranking priority
  
  // Execution Information (JSON stored as String)
  executionData   String?  // JSON: { entry, stop, targets, riskReward, positionSize }
  
  // System Results Summary (JSON stored as String) 
  systemsData     String?  // JSON: Simplified systems results
  
  // Market Classification (for elite system)
  sector          String?  @default("Unknown")
  country         String?  @default("US")
  exchange        String?  // NYSE, NASDAQ, etc.
  
  // Status and Metadata
  status          String   @default("ACTIVE") // "ACTIVE", "EXECUTED", "EXPIRED", "REMOVED"
  priority        Int      @default(1)        // 1=Low, 2=Medium, 3=High (based on grade/confidence)
  nextStepSummary String?  // What to do next
  
  // Timestamps
  addedAt         DateTime @default(now())
  lastAnalyzedAt  DateTime @default(now()) 
  updatedAt       DateTime @updatedAt
  
  @@index([decisionAction])
  @@index([decisionGrade])
  @@index([priority])
  @@index([market])
  @@index([status])
  @@index([tier])              // Elite index
  @@index([signalEvolution])   // Elite index
  @@index([elitePriority])     // Elite index
}

model TradeAlert {
  id          Int      @id @default(autoincrement())
  tradeId     Int
  alertType   String   // 'EXIT_WARNING', 'STOP_BREACH', 'TARGET_APPROACH', 'VOLUME_SPIKE', 'TREND_BREAK'
  priority    String   // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime? // Auto-cleanup old alerts
  
  // Additional context data (JSON as string)
  contextData String?  // JSON: { currentPrice, triggerPrice, riskLevel, etc. }
  
  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  
  @@index([tradeId])
  @@index([priority])
  @@index([isRead])
  @@index([createdAt])
}

// Signal History Table for Alert System
model SignalHistory {
  id                String   @id @default(cuid())
  symbol            String
  action            String   // BUY, WATCH, AVOID, SELL, etc.
  confidence        Float
  grade             String   // A+, A, B+, etc.
  signalQuality     String   // INSTITUTIONAL_GRADE, STANDARD, etc.
  universe          String   // SP500_CORE, SATELLITE, etc.
  analysisTimestamp DateTime @default(now())
  metadata          String?  // JSON string with additional analysis data
  
  @@index([symbol, analysisTimestamp])
  @@index([analysisTimestamp])
}

// Alert History Table (Optional - to track sent alerts)
model AlertHistory {
  id          String   @id @default(cuid())
  type        String   // CRITICAL, URGENT, IMPORTANT
  category    String   // SIGNAL_BREAKDOWN, NEW_OPPORTUNITY, etc.
  symbol      String
  message     String
  sentAt      DateTime @default(now())
  acknowledged Boolean @default(false)
  
  @@index([symbol, sentAt])
  @@index([type, sentAt])
}

// 2. AI_PERFORMANCE_METRICS (OPTIONAL - Enhanced Monitoring)
model AIPerformanceMetrics {
  id                Int       @id @default(autoincrement())
  
  // Time Period
  periodStart       DateTime
  periodEnd         DateTime
  
  // Performance Data
  symbol            String?   // null = all symbols
  userId            String?   // null = all users
  
  // AI vs Baseline Metrics
  aiTotalTrades     Int       @default(0)
  aiWinRate         Float     @default(0)
  aiAvgReturn       Float     @default(0)
  aiMaxDrawdown     Float     @default(0)
  
  baselineTotalTrades Int     @default(0)
  baselineWinRate   Float     @default(0)
  baselineAvgReturn Float     @default(0)
  baselineMaxDrawdown Float   @default(0)
  
  // ROI Analysis
  aiROI             Float     @default(0)
  estimatedCost     Float     @default(0)
  
  // Metadata
  calculatedAt      DateTime  @default(now())
  
  @@index([periodStart, periodEnd])
  @@index([symbol, userId])
}

// 3. AI_SYSTEM_LOGS (OPTIONAL - System Health Tracking)
model AISystemLogs {
  id                Int       @id @default(autoincrement())
  
  // Event Data
  eventType         String    // "ENHANCEMENT", "ERROR", "HEALTH_CHECK"
  component         String    // "NARRATIVE", "LEARNING", "MONITORING"
  
  // Request Data
  symbol            String?
  userId            String?
  requestData       String?   // JSON string
  
  // Result Data
  success           Boolean
  responseTime      Int?      // milliseconds
  errorMessage      String?
  
  // Circuit Breaker Data
  circuitBreakerState String? // "CLOSED", "OPEN", "HALF_OPEN"
  
  // Timestamp
  timestamp         DateTime  @default(now())
  
  @@index([eventType, component])
  @@index([timestamp])
}
